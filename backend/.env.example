# TMDB credentials (either works; create a key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
# Optional v4 read access token; takes precedence over TMDB_API_KEY when set.
TMDB_ACCESS_TOKEN=

# Cache lifetime for TMDB responses, in seconds.
TMDB_CACHE_TTL=3600

# Auth
AUTH_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Leave blank to use backend/data/cinemind.db (SQLite).
DATABASE_URL=

# Optional tuning for candidate generation.
TMDB_MAX_LANGUAGE_REQUESTS=6
TMDB_MAX_GENRE_REQUESTS=4
TMDB_MAX_FAVOURITE_SEEDS=3
TMDB_MIN_CANDIDATES=40
CORS_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173
